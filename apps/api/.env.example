# Copie para .env e preencha com valores locais.
# NUNCA commitar o .env real.

NODE_ENV=development
PORT=3000

# Ao rodar via docker-compose, use o host "postgres"; rodando a API fora do
# compose (npm run dev:api), use "localhost".
DATABASE_URL=postgresql://central:central_dev_password@localhost:5432/central_operacoes?schema=public
REDIS_URL=redis://localhost:6379

# Gere um valor forte, ex.: openssl rand -base64 48
JWT_ACCESS_SECRET=troque-por-um-segredo-forte-de-pelo-menos-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

CORS_ORIGIN=http://localhost:5173
